OBS_WEBSOCKET_ADDRESS=192.168.1.147:4455
OBS_WEBSOCKET_PASSWORD=supersecretpasscode
ATEM_IP_ADDRESS=192.168.1.123

# Port the server (API + built client) listens on. Defaults to 3131.
# PORT=3131

# Must exactly match a Redirect URL registered on the Twitch application(s)
# used by your twitch-eventsub listeners, and must be reachable from
# whichever browser completes the /oauth/twitch/authorize flow. Defaults to
# http://localhost:3131/oauth/twitch/callback, which only works when the
# person authorizing is on this same machine - authorizing on someone else's
# channel requires this server to be reachable from their network (e.g. via
# a tunnel) and this variable set to match.
#
# Running the client with `npm run dev` (Vite on :5173) instead of a
# production build? Point this at the Vite dev server instead -
# http://localhost:5173/oauth/twitch/callback - and register that same URL
# on the Twitch app. Vite's /oauth proxy forwards the request through to
# this server either way, but the callback's final redirect back into the
# app is relative, so it lands on whichever origin actually served the
# callback request - :5173 with this set, :3131 (a build that may not even
# exist yet during `npm run dev`) without it.
TWITCH_OAUTH_REDIRECT_URI=http://localhost:3131/oauth/twitch/callback
