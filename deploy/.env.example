# Where thebit itself is served. Keep this outside SISH_DOMAIN (not a
# subdomain of it) so the two don't compete for the same hostnames.
THEBIT_DOMAIN=thebit.example.com

# The password for thebit's admin login.
THEBIT_ADMIN_PASSWORD=

# Optional: the key thebit encrypts stored secrets with (32 bytes, hex or
# base64, e.g. from `openssl rand -base64 32`). Left empty, one is generated
# into the thebit-data volume on first run.
THEBIT_SECRET_KEY=

# The domain tunnels live under - each one gets a subdomain of it. Needs an
# A record for the domain itself and a wildcard A record (*.<domain>), both
# pointing at this server.
SISH_DOMAIN=tunnel.example.com

# Your Traefik setup: the Docker network Traefik watches, its https
# entrypoint, and a certificate resolver that uses a DNS challenge (needed
# for the wildcard certificate).
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
